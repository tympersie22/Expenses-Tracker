{
  "name": "expenses-tracker",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && node scripts/package-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:localization": "node scripts/check-localization.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "test:lifecycle": "node scripts/verify-lifecycle.mjs",
    "test:api": "node scripts/verify-api.mjs",
    "test:recovery": "node scripts/verify-recovery.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:prune": "tsx scripts/prune.ts",
    "launch:prepare": "node scripts/prepare-launch.mjs",
    "launch:check": "node scripts/check-launch.mjs"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "3.0.2",
    "lucide-react": "0.487.0",
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.24.4",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.25",
    "prisma": "5.22.0",
    "tsx": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "nanoid": "^3.3.18"
  }
}
